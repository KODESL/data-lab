# Copy to .env. Everything defaults to the local mock lab.
MADRID_DATA_MODE=mock          # mock | real
MADRID_LAKE_ROOT=data/lake     # local path, s3://bucket/prefix or abfss://...
MADRID_MOCK_MUNICIPIOS=179
MADRID_YEAR_START=2000
MADRID_YEAR_END=2025
MADRID_HORIZON_END=2036
MADRID_SMALL_THRESHOLD=20000
MADRID_SEED=28

# Optional: S3-compatible lake (MinIO in compose). Leave empty for local files.
# MADRID_S3_ENDPOINT=http://localhost:9000
# MADRID_S3_ACCESS_KEY=madrid
# MADRID_S3_SECRET_KEY=madridmadrid

# Optional: Postgres for analysts / BI. The API reads gold Parquet, not this.
# MADRID_DATABASE_URL=postgresql://madrid:madrid@localhost:5432/madrid
